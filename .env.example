# ─── CodePilot AI — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials into git.

# ─── App Settings ─────────────────────────────────────────────────────────────
APP_NAME=CodePilot AI
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# JWT signing secret (Generate with: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated list or JSON array)
# Include your Vercel deployment URL here:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app

# ─── Frontend Environment Variables ───────────────────────────────────────────
# Set in Vercel: Points to your deployed FastAPI backend on Railway
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app/api/v1
VITE_API_URL=https://your-backend.up.railway.app/api/v1

# ─── Database (PostgreSQL / Neon / Supabase / Railway) ─────────────────────────
# For Neon / Supabase / Railway: Use postgresql+asyncpg:// scheme
# Local Docker: postgresql+asyncpg://codepilot:codepilot@postgres:5432/codepilot
DATABASE_URL=postgresql+asyncpg://user:password@host.railway.app:5432/railway
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis (Railway Redis or Upstash Redis) ───────────────────────────────────
# Local Docker: redis://redis:6379/0
# Upstash: rediss://default:password@host.upstash.io:6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── Vector Database (Qdrant Cloud / Managed) ──────────────────────────────────
# Local Docker: http://qdrant:6333 (leave QDRANT_API_KEY empty)
# Qdrant Cloud: https://xxxxxx-xxxx.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=codepilot_embeddings

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Options: openai | gemini | ollama
LLM_PROVIDER=openai

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (Local only, optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ─── Agent Execution Limits ───────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=600

# ─── GitHub Integration ───────────────────────────────────────────────────────
# Optional: Personal Access Token (classic) with 'repo' and 'pull_requests' scopes
# If left empty, CodePilot runs simulated safe PR reviews without touching GitHub
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
