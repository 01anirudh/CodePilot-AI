# ─── CodePilot AI — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your values.

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=CodePilot AI
DEBUG=false
ENVIRONMENT=development
SECRET_KEY=iCGOtORnZ7RHuozL7v6wPhCOvYrkcRiE

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Options: openai | gemini | ollama
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gemini-2.0-flash

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama

# ─── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Personal access token with 'repo' and 'pull_requests' scopes
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ─── Database ─────────────────────────────────────────────────────────────────
# For local dev (Docker Compose fills these automatically)
DATABASE_URL=postgresql+asyncpg://codepilot:codepilot@localhost:5432/codepilot

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=codepilot_embeddings

# ─── JWT ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=1440
